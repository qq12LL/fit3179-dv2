{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Normalised stacked bar - share of students in each sector from each socio-educational advantage quarter, 2025, weighted by enrolments. Purple-to-navy diverging order (same as the school advantage colours): least to most advantaged.",
  "data": {"url": "data/schools.csv"},
  "transform": [
    {"filter": "isValid(datum.sea_bottom_pct) && isValid(datum.enrolments)"},
    {"calculate": "datum.sea_bottom_pct * datum.enrolments / 100", "as": "Least advantaged quarter"},
    {"calculate": "datum.sea_lowmid_pct * datum.enrolments / 100", "as": "Lower-middle quarter"},
    {"calculate": "datum.sea_upmid_pct * datum.enrolments / 100", "as": "Upper-middle quarter"},
    {"calculate": "datum.sea_top_pct * datum.enrolments / 100", "as": "Most advantaged quarter"},
    {"fold": ["Least advantaged quarter", "Lower-middle quarter", "Upper-middle quarter", "Most advantaged quarter"], "as": ["quarter", "students"]},
    {"aggregate": [{"op": "sum", "field": "students", "as": "students"}], "groupby": ["sector", "quarter"]},
    {"joinaggregate": [{"op": "sum", "field": "students", "as": "sector_total"}], "groupby": ["sector"]},
    {"calculate": "datum.students / datum.sector_total", "as": "share"},
    {"calculate": "indexof(['Least advantaged quarter','Lower-middle quarter','Upper-middle quarter','Most advantaged quarter'], datum.quarter)", "as": "q_order"}
  ],
  "width": 490,
  "height": 170,
  "encoding": {
    "y": {"field": "sector", "type": "nominal", "title": null, "sort": ["Government", "Catholic", "Independent"],
      "axis": {"domain": false, "ticks": false, "labelPadding": 8, "labelFontWeight": 600, "labelFontSize": 15}},
    "x": {"field": "share", "type": "quantitative", "stack": "normalize", "title": "Share of the sector's students",
      "axis": {"format": "%", "values": [0, 0.25, 0.5, 0.75, 1], "grid": false, "domain": false}},
    "order": {"field": "q_order"}
  },
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "#fffbf4", "strokeWidth": 2, "height": {"band": 0.72}},
      "encoding": {
        "color": {"field": "quarter", "type": "ordinal", "title": "Family background of students",
          "scale": {"domain": ["Least advantaged quarter", "Lower-middle quarter", "Upper-middle quarter", "Most advantaged quarter"],
                    "range": ["#4b2f80", "#b8a8d8", "#8fb2dc", "#1f4f8c"]},
          "legend": {"orient": "top", "columns": 2, "labelLimit": 300}},
        "tooltip": [
          {"field": "sector", "title": "Sector"},
          {"field": "quarter", "title": "Family background"},
          {"field": "share", "title": "Share of students", "format": ".1%"},
          {"field": "students", "title": "Approximate number of students", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 14, "fontWeight": 700},
      "encoding": {
        "x": {"field": "share", "type": "quantitative", "stack": "normalize", "bandPosition": 0.5},
        "text": {"field": "share", "type": "quantitative", "format": ".0%"},
        "color": {"condition": {"test": "datum.quarter == 'Least advantaged quarter' || datum.quarter == 'Most advantaged quarter'", "value": "#ffffff"}, "value": "#2b2118"}
      }
    }
  ]
}
