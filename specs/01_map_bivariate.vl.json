{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MAP 1 - Bivariate choropleth (normalised data): area disadvantage (ABS SEIFA IRSD 2021, purple) x share of children developmentally vulnerable on one or more AEDC domains (2024, orange), by council area. Ocean layer and 10-degree graticule for geographic context; annotations sit in the ocean with leader lines so they do not cover any council area.",
  "hconcat": [
    {
      "width": 392,
      "height": 370,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0,
          0
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "MultiPoint",
            "coordinates": [
              [
                112.3,
                -9.6
              ],
              [
                154.2,
                -43.9
              ]
            ]
          }
        }
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e3ecef",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "graticule": {
              "step": [
                10,
                10
              ]
            }
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#ffffff",
            "strokeWidth": 0.8,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/australia_lga_2021.topo.json",
            "format": {
              "type": "topojson",
              "feature": "lga"
            }
          },
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "on": "pointerover",
                "clear": "pointerout",
                "fields": [
                  "lga_code"
                ]
              }
            }
          ],
          "transform": [
            {
              "calculate": "datum.properties.lga_code",
              "as": "lga_code"
            },
            {
              "lookup": "lga_code",
              "from": {
                "data": {
                  "url": "data/lga.csv",
                  "format": {
                    "parse": {
                      "irsd_decile": "number",
                      "aedc_vuln1_pct_2024": "number"
                    }
                  }
                },
                "key": "lga_code",
                "fields": [
                  "lga_name",
                  "state",
                  "irsd_decile",
                  "aedc_vuln1_pct_2024"
                ]
              }
            },
            {
              "calculate": "datum.irsd_decile <= 3 ? 2 : datum.irsd_decile <= 7 ? 1 : 0",
              "as": "dis_class"
            },
            {
              "calculate": "datum.aedc_vuln1_pct_2024 > 0 ? (datum.aedc_vuln1_pct_2024 >= 28 ? 2 : datum.aedc_vuln1_pct_2024 >= 21 ? 1 : 0) : -1",
              "as": "vul_class"
            },
            {
              "calculate": "datum.vul_class < 0 ? 'none' : datum.dis_class + '-' + datum.vul_class",
              "as": "biv"
            },
            {
              "calculate": "['Least disadvantaged third','Middle','Most disadvantaged third'][datum.dis_class]",
              "as": "Area disadvantage"
            },
            {
              "calculate": "datum.vul_class < 0 ? 'Not published' : format(datum.aedc_vuln1_pct_2024, '.1f') + '%'",
              "as": "Children vulnerable"
            },
            {
              "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]",
              "as": "State"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#fffbf4",
            "strokeWidth": 0.25
          },
          "encoding": {
            "color": {
              "field": "biv",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "0-0",
                  "0-1",
                  "0-2",
                  "1-0",
                  "1-1",
                  "1-2",
                  "2-0",
                  "2-1",
                  "2-2",
                  "none"
                ],
                "range": [
                  "#f7efe2",
                  "#f2b37b",
                  "#d9691e",
                  "#b9a5d8",
                  "#b87c74",
                  "#a5491c",
                  "#6e4fa3",
                  "#6e3b57",
                  "#622315",
                  "#c9c2b8"
                ]
              }
            },
            "strokeWidth": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": 1.6
              },
              "value": 0.25
            },
            "stroke": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": "#1d1712"
              },
              "value": "#fffbf4"
            },
            "tooltip": [
              {
                "field": "lga_name",
                "title": "Council area"
              },
              {
                "field": "State",
                "title": "State"
              },
              {
                "field": "Area disadvantage",
                "title": "Area disadvantage"
              },
              {
                "field": "Children vulnerable",
                "title": "Children developmentally vulnerable"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/australia_lga_2021.topo.json",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#5a4a3a",
            "strokeWidth": 0.9
          }
        },
        {
          "data": {
            "values": [
              {
                "t": "North and centre:|high on both",
                "lon": 113.2,
                "lat": -13.2,
                "align": "left",
                "lon2": 128.0,
                "lat2": -18.5
              },
              {
                "t": "City outer suburbs:|high on both",
                "lon": 135.2,
                "lat": -39.4,
                "align": "right",
                "lon2": 138.65,
                "lat2": -34.72
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#2b2118",
            "strokeWidth": 1,
            "strokeDash": [
              3,
              2
            ]
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "t": "North and centre:|high on both",
                "lon": 113.2,
                "lat": -13.2,
                "align": "left",
                "lon2": 128.0,
                "lat2": -18.5
              },
              {
                "t": "City outer suburbs:|high on both",
                "lon": 135.2,
                "lat": -39.4,
                "align": "right",
                "lon2": 138.65,
                "lat2": -34.72
              }
            ]
          },
          "mark": {
            "type": "circle",
            "size": 22,
            "color": "#2b2118",
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon2",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat2",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "t": "North and centre:|high on both",
                "lon": 113.2,
                "lat": -13.2,
                "align": "left",
                "lon2": 128.0,
                "lat2": -18.5
              },
              {
                "t": "City outer suburbs:|high on both",
                "lon": 135.2,
                "lat": -39.4,
                "align": "right",
                "lon2": 138.65,
                "lat2": -34.72
              }
            ]
          },
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#2b2118",
            "lineBreak": "|",
            "lineHeight": 16,
            "baseline": "bottom",
            "dy": -24,
            "align": {
              "expr": "datum.align"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "width": 126,
      "height": 126,
      "data": {
        "values": [
          {
            "d": 0,
            "v": 0,
            "c": "#f7efe2"
          },
          {
            "d": 0,
            "v": 1,
            "c": "#f2b37b"
          },
          {
            "d": 0,
            "v": 2,
            "c": "#d9691e"
          },
          {
            "d": 1,
            "v": 0,
            "c": "#b9a5d8"
          },
          {
            "d": 1,
            "v": 1,
            "c": "#b87c74"
          },
          {
            "d": 1,
            "v": 2,
            "c": "#a5491c"
          },
          {
            "d": 2,
            "v": 0,
            "c": "#6e4fa3"
          },
          {
            "d": 2,
            "v": 1,
            "c": "#6e3b57"
          },
          {
            "d": 2,
            "v": 2,
            "c": "#622315"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "#fffbf4",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "v",
              "type": "ordinal",
              "title": "Children vulnerable →",
              "axis": {
                "labelExpr": "['Under 21%','21–28%','Over 28%'][datum.value]",
                "labelAngle": -40,
                "labelAlign": "right",
                "domain": false,
                "ticks": false,
                "labelFontSize": 13
              }
            },
            "y": {
              "field": "d",
              "type": "ordinal",
              "sort": "descending",
              "title": "Area disadvantage →",
              "axis": {
                "labelExpr": "['Low','Middle','High'][datum.value]",
                "domain": false,
                "ticks": false,
                "labelFontSize": 13
              }
            },
            "color": {
              "field": "c",
              "type": "nominal",
              "scale": null
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.d == 2 && datum.v == 2"
            }
          ],
          "mark": {
            "type": "text",
            "color": "#ffffff",
            "fontWeight": "bold",
            "fontSize": 12,
            "text": "Both"
          },
          "encoding": {
            "x": {
              "field": "v",
              "type": "ordinal"
            },
            "y": {
              "field": "d",
              "type": "ordinal",
              "sort": "descending"
            }
          }
        }
      ]
    }
  ],
  "spacing": 16
}
