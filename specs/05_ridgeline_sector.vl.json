{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline plot - distribution (density) of school advantage scores (ICSEA) for Government, Catholic and Independent schools, 2025. One neutral colour: rows are labelled directly, so colour is not needed to tell sectors apart. Dashed line = national average of 1000.",
  "data": {"url": "data/schools.csv"},
  "transform": [
    {"filter": "isValid(datum.icsea) && datum.icsea > 0"},
    {"density": "icsea", "groupby": ["sector"], "extent": [500, 1250], "steps": 150, "as": ["icsea", "density"]}
  ],
  "facet": {
    "row": {"field": "sector", "type": "nominal", "title": null, "sort": ["Government", "Catholic", "Independent"],
      "header": {"labelAngle": 0, "labelAlign": "left", "labelOrient": "left", "labelPadding": 8, "labelFontWeight": 600, "labelFontSize": 15}}
  },
  "spec": {
    "width": 480,
    "height": 70,
    "layer": [
      {
        "mark": {"type": "area", "interpolate": "monotone", "fill": "#8a6f55", "fillOpacity": 0.8, "stroke": "#fffbf4", "strokeWidth": 1.5},
        "encoding": {
          "x": {"field": "icsea", "type": "quantitative", "title": "School advantage score (national average: 1,000)", "scale": {"domain": [500, 1250]},
            "axis": {"grid": false, "values": [500, 600, 700, 800, 900, 1000, 1100, 1200], "format": ",d"}},
          "y": {"field": "density", "type": "quantitative", "stack": null, "axis": null, "scale": {"range": [70, -40]}}
        }
      },
      {
        "mark": {"type": "rule", "color": "#2b2118", "strokeDash": [4, 3], "strokeWidth": 1.2},
        "encoding": {"x": {"datum": 1000}}
      }
    ]
  },
  "spacing": 0,
  "config": {"view": {"stroke": null}}
}
