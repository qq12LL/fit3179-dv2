{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples (repeat operator) - the same choropleth (normalised data) of the share of children developmentally vulnerable (one or more AEDC domains), repeated for each census year from 2009 to 2024 on one shared sequential orange scale (same colour as child vulnerability elsewhere). Hover any council to see its value in that year.",
  "repeat": ["2009", "2012", "2015", "2018", "2021", "2024"],
  "columns": 3,
  "spec": {
    "width": 290,
    "height": 250,
    "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0, 0]},
    "layer": [
      {
        "data": {"url": "data/australia_lga_2021.topo.json", "format": {"type": "topojson", "feature": "lga"}},
        "mark": {"type": "geoshape", "fill": "#c9c2b8", "stroke": "#fffbf4", "strokeWidth": 0.15}
      },
      {
        "data": {"url": "data/australia_lga_2021.topo.json", "format": {"type": "topojson", "feature": "lga"}},
        "transform": [
          {"calculate": "datum.properties.lga_code", "as": "lga_code"},
          {"calculate": "datum.properties.lga_name", "as": "Council area"},
          {"lookup": "lga_code",
           "from": {"data": {"url": "data/aedc_lga_years.csv",
                             "format": {"parse": {"2009": "number", "2012": "number", "2015": "number", "2018": "number", "2021": "number", "2024": "number"}}},
                    "key": "lga_code", "fields": ["2009", "2012", "2015", "2018", "2021", "2024"]}}
        ],
        "mark": {"type": "geoshape", "stroke": "#fffbf4", "strokeWidth": 0.15},
        "encoding": {
          "color": {
            "field": {"repeat": "repeat"}, "type": "quantitative",
            "title": "Children developmentally vulnerable (%)",
            "scale": {"domain": [10, 20, 30, 45], "range": ["#fbe9d6", "#f2b37b", "#d9691e", "#6b2c08"], "clamp": true, "interpolate": "lab"},
            "legend": {"orient": "top", "direction": "horizontal", "gradientLength": 300, "values": [10, 20, 30, 40], "labelExpr": "datum.value + '%'"}
          },
          "tooltip": [
            {"field": "Council area", "title": "Council area"},
            {"field": {"repeat": "repeat"}, "type": "quantitative", "title": "Children vulnerable (%)", "format": ".1f"}
          ]
        }
      },
      {
        "data": {"url": "data/australia_lga_2021.topo.json", "format": {"type": "topojson", "feature": "states"}},
        "mark": {"type": "geoshape", "filled": false, "stroke": "#5a4a3a", "strokeWidth": 0.6}
      },
      {
        "data": {"values": [{"lon": 113.5, "lat": -12.0}]},
        "mark": {"type": "text", "align": "left", "fontSize": 22, "fontWeight": 700, "font": "'Source Serif 4', Georgia, serif", "color": "#2b2118"},
        "encoding": {
          "longitude": {"field": "lon", "type": "quantitative"},
          "latitude": {"field": "lat", "type": "quantitative"},
          "text": {"datum": {"repeat": "repeat"}}
        }
      }
    ]
  },
  "spacing": 16
}
