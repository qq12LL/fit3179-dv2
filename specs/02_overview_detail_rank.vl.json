{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Overview + detail (brush) - all council areas ranked from highest to lowest share of children developmentally vulnerable (AEDC 2024). Brushing the small overview strip sets the x-axis domain of the large detail chart, which shows council names. Colour = area disadvantage group (purple, same as the bivariate map).",
  "data": {
    "url": "data/lga.csv",
    "format": {
      "parse": {
        "aedc_vuln1_pct_2024": "number",
        "irsd_decile": "number",
        "aedc_children_2024": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.aedc_vuln1_pct_2024 > 0"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "aedc_vuln1_pct_2024",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.irsd_decile <= 3 ? 'Most disadvantaged third' : datum.irsd_decile <= 7 ? 'Middle third' : 'Least disadvantaged third'",
      "as": "Area disadvantage"
    },
    {
      "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]",
      "as": "State"
    },
    {
      "calculate": "datum.rank - 0.42",
      "as": "x0"
    },
    {
      "calculate": "datum.rank + 0.42",
      "as": "x1"
    }
  ],
  "vconcat": [
    {
      "width": 600,
      "height": 320,
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Rank (1 is the highest share of vulnerable children)",
          "scale": {
            "domain": {
              "param": "brush"
            }
          },
          "axis": {
            "tickMinStep": 1,
            "format": "d",
            "grid": false
          }
        },
        "y": {
          "field": "aedc_vuln1_pct_2024",
          "type": "quantitative",
          "title": "Children vulnerable (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "labelExpr": "datum.value + '%'",
            "grid": true,
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "clip": true,
            "cornerRadiusTopLeft": 2,
            "cornerRadiusTopRight": 2
          },
          "encoding": {
            "x2": {
              "field": "x1"
            },
            "y2": {
              "datum": 0
            },
            "color": {
              "field": "Area disadvantage",
              "type": "nominal",
              "title": "Area disadvantage",
              "scale": {
                "domain": [
                  "Most disadvantaged third",
                  "Middle third",
                  "Least disadvantaged third"
                ],
                "range": [
                  "#6e4fa3",
                  "#b9a5d8",
                  "#e2dbee"
                ]
              },
              "legend": {
                "orient": "top"
              }
            },
            "stroke": {
              "value": "#b9a5d8"
            },
            "strokeWidth": {
              "value": 0.4
            },
            "tooltip": [
              {
                "field": "rank",
                "title": "Rank"
              },
              {
                "field": "lga_name",
                "title": "Council area"
              },
              {
                "field": "State",
                "title": "State"
              },
              {
                "field": "aedc_vuln1_pct_2024",
                "title": "Children vulnerable (%)",
                "format": ".1f"
              },
              {
                "field": "aedc_children_2024",
                "title": "Children assessed",
                "format": ",d"
              },
              {
                "field": "Area disadvantage",
                "title": "Area disadvantage"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.aedc_vuln1_pct_2024 >= 40"
            }
          ],
          "mark": {
            "type": "text",
            "clip": true,
            "angle": -90,
            "align": "right",
            "baseline": "middle",
            "dx": -6,
            "fontSize": 12,
            "color": "#ffffff"
          },
          "encoding": {
            "x": {
              "field": "rank",
              "type": "quantitative"
            },
            "text": {
              "field": "lga_name"
            },
            "opacity": {
              "condition": {
                "test": "brush.x0 && (brush.x0[1] - brush.x0[0]) <= 60",
                "value": 1
              },
              "value": 0
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.aedc_vuln1_pct_2024 < 40"
            }
          ],
          "mark": {
            "type": "text",
            "clip": true,
            "angle": -90,
            "align": "left",
            "baseline": "middle",
            "dx": 5,
            "fontSize": 12,
            "color": "#2b2118"
          },
          "encoding": {
            "x": {
              "field": "rank",
              "type": "quantitative"
            },
            "text": {
              "field": "lga_name"
            },
            "opacity": {
              "condition": {
                "test": "brush.x0 && (brush.x0[1] - brush.x0[0]) <= 60",
                "value": 1
              },
              "value": 0
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#2b2118",
            "strokeDash": [
              5,
              4
            ],
            "strokeWidth": 1.2
          },
          "encoding": {
            "y": {
              "datum": 23.5
            },
            "x": null
          }
        },
        {
          "data": {
            "values": [
              {
                "label": "Dashed line: Australia, 23.5%"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "dy": -9,
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#2b2118"
          },
          "encoding": {
            "y": {
              "datum": 98
            },
            "x": {
              "value": 598
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "width": 600,
      "height": 64,
      "title": {
        "text": "Overview: drag the grey window to choose council areas",
        "fontSize": 14,
        "fontWeight": 400,
        "font": "'Source Sans 3', Arial, sans-serif",
        "color": "#4a3b2e"
      },
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          },
          "value": {
            "x": [
              0.5,
              30.5
            ]
          }
        }
      ],
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Rank of all 450 council areas",
          "scale": {
            "domain": [
              0,
              451
            ],
            "nice": false
          },
          "axis": {
            "format": "d",
            "values": [
              1,
              50,
              100,
              150,
              200,
              250,
              300,
              350,
              400,
              450
            ],
            "grid": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "aedc_vuln1_pct_2024",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y2": {
          "datum": 0
        },
        "color": {
          "field": "Area disadvantage",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Most disadvantaged third",
              "Middle third",
              "Least disadvantaged third"
            ],
            "range": [
              "#6e4fa3",
              "#b9a5d8",
              "#e2dbee"
            ]
          }
        }
      }
    }
  ],
  "spacing": 16
}