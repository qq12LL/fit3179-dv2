                  ]
                ]
              }
            }
          },
          "data": {
            "url": "data/australia_lga_2021.topo.json",
            "format": {
              "type": "topojson",
              "feature": "lga"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.lga_code",
              "as": "lga_code"
            },
            {
              "filter": "datum.properties.cx > 144.3 && datum.properties.cx < 145.8 && datum.properties.cy > -38.5 && datum.properties.cy < -37.3"
            },
            {
              "lookup": "lga_code",
              "from": {
                "data": {
                  "url": "data/lga.csv",
                  "format": {
                    "parse": {
                      "y12_pct_25_34": "number",
                      "irsd_decile": "number"
                    }
                  }
                },
                "key": "lga_code",
                "fields": [
                  "lga_name",
                  "y12_pct_25_34",
                  "irsd_decile"
                ]
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#fffbf4",
            "strokeWidth": 0.6,
            "clip": true
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "!(datum.y12_pct_25_34 > 0)",
                "value": "#c9c2b8"
              },
              "field": "y12_pct_25_34",
              "type": "quantitative",
              "scale": {
                "domain": [
                  25,
                  50,
                  70,
                  85,
                  100
                ],
                "range": [
                  "#eef3f9",
                  "#bcd0ea",
                  "#6f9bd0",
                  "#2a5f9e",
                  "#12305a"
                ],
                "clamp": true,
                "interpolate": "lab"
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "lga_name",
                "title": "Council area"
              },
              {
                "field": "y12_pct_25_34",
                "title": "Aged 25 to 34 who finished Year 12 (%)",
                "format": ".1f"
              },
              {
                "field": "irsd_decile",
                "title": "Disadvantage decile (1 is most disadvantaged)"
              }
