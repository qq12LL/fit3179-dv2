{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell / dot strip - share of children developmentally vulnerable by remoteness of where they live, for each AEDC skill area, Australia 2024. Teal ordinal ramp = remoteness (same colours as the university line chart). The bar spans Major Cities to Very Remote.",
  "data": {"url": "data/aedc_by_remoteness.csv"},
  "transform": [
    {"filter": "datum.state == 'Australia' && datum.year == 2024 && datum.remoteness != 'All children' && datum.domain != 'Two or more domains'"},
    {"calculate": "replace(replace(datum.remoteness, ' of Australia', ''), ' Australia', '')", "as": "area"},
    {"calculate": "indexof(['Major Cities','Inner Regional','Outer Regional','Remote','Very Remote'], datum.area)", "as": "area_order"},
    {"calculate": "['Major cities','Inner regional','Outer regional','Remote','Very remote'][datum.area_order]", "as": "Where the child lives"},
    {"calculate": "{'One or more domains':'Any skill area','Physical health':'Physical health','Social competence':'Social skills','Emotional maturity':'Emotional maturity','Language & thinking':'Language and thinking','Communication':'Communication'}[datum.domain]", "as": "Skill area"}
  ],
  "width": 470,
  "height": 280,
  "encoding": {
    "y": {"field": "Skill area", "type": "nominal", "title": null,
      "sort": ["Any skill area", "Language and thinking", "Physical health", "Communication", "Social skills", "Emotional maturity"],
      "axis": {"domain": false, "ticks": false, "labelPadding": 8, "labelFontWeight": {"expr": "datum.value == 'Any skill area' ? 700 : 400"}}},
    "x": {"field": "pct_vulnerable", "type": "quantitative", "title": "Children developmentally vulnerable (%)",
      "scale": {"domain": [0, 50]}, "axis": {"grid": true, "tickCount": 5}}
  },
  "layer": [
    {
      "transform": [
        {"filter": "datum.area == 'Major Cities' || datum.area == 'Very Remote'"},
        {"aggregate": [{"op": "min", "field": "pct_vulnerable", "as": "lo"}, {"op": "max", "field": "pct_vulnerable", "as": "hi"}], "groupby": ["Skill area"]}
      ],
      "mark": {"type": "rule", "strokeWidth": 7, "color": "#ece2d2", "strokeCap": "round"},
      "encoding": {"x": {"field": "lo", "type": "quantitative"}, "x2": {"field": "hi"}}
    },
    {
      "mark": {"type": "circle", "size": 150, "opacity": 1, "stroke": "#fffbf4", "strokeWidth": 1.5},
      "encoding": {
        "color": {"field": "Where the child lives", "type": "ordinal", "title": "Where the child lives",
          "scale": {"domain": ["Major cities", "Inner regional", "Outer regional", "Remote", "Very remote"],
                    "range": ["#b9dde2", "#7cbcc6", "#3f95a3", "#2a6c78", "#1d4f58"]}},
        "order": {"field": "area_order"},
        "tooltip": [
          {"field": "Skill area", "title": "Skill area"},
          {"field": "Where the child lives", "title": "Where the child lives"},
          {"field": "pct_vulnerable", "title": "Children vulnerable (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.area == 'Very Remote' || datum.area == 'Major Cities'"}],
      "mark": {"type": "text", "dy": -15, "fontSize": 13, "color": "#4a3b2e"},
      "encoding": {"text": {"field": "pct_vulnerable", "type": "quantitative", "format": ".0f"}}
    }
  ]
}
